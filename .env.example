# Upstream madmail HTTP origin (Vite dev proxy only — not exposed to the browser)
# Default is already http://127.0.0.1:8080 when this file is missing.
DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Same-origin /api/admin in the browser (on unless set to 0). Phones use
# http://<laptop-lan-ip>:5173 — Vite forwards to loopback madmail.
VITE_DEV_API_PROXY=1
VITE_DEV_API_PATH=/api/admin

# Phone testing on LAN (camera needs HTTPS — not http://192.168.x.x)
# VITE_DEV_HTTPS=1
# Then: bun run dev --host → open https://YOUR_LAN_IP:5173/ (accept cert warning)
